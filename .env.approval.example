# Copy to .env.approval.local to prepare values privately; that file is gitignored.
# Add these two values to ui-workshop's Production environment on Vercel.
# A local file alone does not configure a deployed function.

# Fine-grained GitHub token scoped only to NazgoooAtanasov/ui-workshop.
# Actions: write; Contents: read; Pull requests: read.
APPROVAL_GITHUB_TOKEN=

# Your private reviewer passphrase, at least 16 characters.
# Enter the same passphrase in Storybook when approving a design revision.
APPROVAL_ACCESS_KEY=
