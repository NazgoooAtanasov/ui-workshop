{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Generic role="group" is valid; its native replacements have narrower semantics.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist/**", "storybook-static/**", "src/generated/**"]
}
