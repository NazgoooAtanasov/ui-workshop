{
  "name": "@poc/ui",
  "version": "0.3.0",
  "private": true,
  "description": "Shared React library and Storybook workshop for the Figma-to-React proof of concept.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test:approval": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "build": "pnpm run typecheck && pnpm run build:lib && pnpm run build-storybook",
    "prepack": "pnpm run build:lib",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@openai/codex": "^0.164.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.3",
    "storybook-addon-pseudo-states": "10.6.3",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
